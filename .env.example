# Copy to .env.local and fill with your own values. Never commit real credentials.

# Four Supabase projects: master catalogue, Unilorin inventory, Tanke inventory, order archive.
SUPABASE_URL_MASTER=
SUPABASE_URL_UNILORIN=
SUPABASE_URL_TANKE=
SUPABASE_URL_ARCHIVE=
SUPABASE_ANON_KEY_MASTER=
SUPABASE_ANON_KEY_UNILORIN=
SUPABASE_ANON_KEY_TANKE=
SUPABASE_ANON_KEY_ARCHIVE=
SUPABASE_SERVICE_KEY_MASTER=
SUPABASE_SERVICE_KEY_UNILORIN=
SUPABASE_SERVICE_KEY_TANKE=
SUPABASE_SERVICE_KEY_ARCHIVE=

# Admin and representative sessions.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
ADMIN_SECRET_PATH=
REP_SECRET_PATH=
DELETE_PRODUCT_PASSWORD=
CLEAR_DATABASE_PASSWORD=

# Boutique contact numbers used for WhatsApp handoff.
ADMIN_PHONE_UNILORIN=
ADMIN_PHONE_TANKE=

# Transfer account details shown at checkout.
NEXT_PUBLIC_ACCOUNT_NAME_UNILORIN=
NEXT_PUBLIC_ACCOUNT_NUMBER_UNILORIN=
NEXT_PUBLIC_ACCOUNT_NAME_TANKE=
NEXT_PUBLIC_ACCOUNT_NUMBER_TANKE=

# Optional: sensory-copy helper.
TINYFISH_API_KEY=
